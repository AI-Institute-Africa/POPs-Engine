# Copy to .env. Never commit real secrets.
# The service defaults to production rules: it refuses to start with dev secrets, without a
# malware scanner, or with the fake reader. POPS_ENV=dev relaxes that for local work only.
POPS_ENV=dev
POPS_JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters

# Malware scanning (clamd). Compose runs one; empty disables scanning (dev only).
POPS_CLAMAV_HOST=clamav

# Cognify identity (OIDC). Tokens must carry pops_role and pops_org claims; finance roles need MFA.
POPS_OIDC_ISSUER=
POPS_OIDC_AUDIENCE=
POPS_OIDC_JWKS_URL=

# Extraction: Ollama Cloud (default). Create a key at ollama.com -> Settings -> Keys.
POPS_VLM_BACKEND=ollama
POPS_OLLAMA_URL=https://ollama.com
POPS_OLLAMA_API_KEY=
POPS_OLLAMA_MODEL=qwen3-vl:235b
# Self-hosted instead: POPS_OLLAMA_URL=http://ollama:11434 and POPS_OLLAMA_MODEL=qwen2.5vl:7b
# Offline demo with synthetic receipts: POPS_VLM_BACKEND=fake
POPS_OCR_BACKEND=tesseract

# Cognify entitlement webhook (HMAC-SHA256 signed, header X-POPs-Signature: t=..,v1=..)
POPS_COGNIFY_WEBHOOK_URL=
POPS_COGNIFY_WEBHOOK_SECRET=change-me

# Shadow mode (blueprint phase 4): advisory AI proposals recorded beside claims and scored
# against human decisions. Never touches claim state; the AI proposer obeys the guardrail kill
# switch. Off by default; GET /shadow/scorecard shows agreement / false-approval / false-hold.
POPS_SHADOW_MODE_ENABLED=false

# Optional calibration files (see docs/configuration.md)
POPS_PROVIDER_TEMPLATES_FILE=
POPS_STATEMENT_PROFILES_FILE=

# Observability: Prometheus at /metrics always; these are optional
POPS_SENTRY_DSN=
POPS_OTEL_ENDPOINT=
